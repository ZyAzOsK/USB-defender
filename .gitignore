# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb

# Virtual environment
.venv/
env/
venv/

# USB Defender generated files
# NOTE: app/signatures.json IS tracked — it ships as the bundled default rule
# set. The live, user-editable copy lives in the per-user data directory
# (~/.local/share/usb-defender, %APPDATA%, Application Support), not here.
app/logs/
*.db
*.db-wal
*.db-shm
quarantine/
*.qfile
*.meta.json
usb_defender_report.json

# Build artifacts
build/
dist/
*.egg-info/

# OS-specific
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Test or debug files
*.bak
*.tmp
*.swp
*.swo

# Quarantine summary (auto-generated; legacy location before the data-dir move)
app/quarantine_summary.json

# Compiled Sidecars — built by scripts/build_sidecar.{sh,bat}, never committed
dashboard/src-tauri/sidecars/usb-defender-*
dashboard/src-tauri/sidecars/_verify_data/

# Tests & Scratch
.pytest_cache/
ws_test.py

# Editor and tooling local config
.editorconfig.local
*.local.json
*.local.md

# PyInstaller
*.spec
portable/build/
portable/dist/

# Tauri build output
dashboard/src-tauri/target/

# Node
node_modules/

